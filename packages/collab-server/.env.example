# zcode collab-server 配置（Bun 自动加载运行目录下的 .env）
# 复制为 .env 并按需修改。

# 服务监听
COLLAB_PORT=8790
COLLAB_HOSTNAME=0.0.0.0

# 数据目录（share blob 的 SQLite 存储）
COLLAB_DATA_DIR=./data

# 管理员登录（dashboard /dash 的房间与分享管理）
# 不设置 COLLAB_ADMIN_PASSWORD 时管理功能整体禁用。
COLLAB_ADMIN_USER=admin
COLLAB_ADMIN_PASSWORD=

# 分享保留天数（0 = 永不过期）与大小上限（字节）
COLLAB_SHARE_TTL_DAYS=30
COLLAB_MAX_SHARE_BYTES=1000000

# 单房间访客上限（超出以 4029 拒绝）
COLLAB_MAX_GUESTS=32
